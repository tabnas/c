{
  "$schema": "https://tabnas.dev/schema/plugin.schema.json",
  "name": "@tabnas/c",
  "go": "github.com/tabnas/c/go",
  "description": "C source parsing for the tabnas engine (C23 plus common compiler extensions), preserving macros.",
  "base": "@tabnas/jsonic",
  "engine": "@tabnas/parser",
  "grammar": "ts/c-grammar.jsonic",
  "extensions": [
    ".c",
    ".h"
  ],
  "specDir": "test/spec",
  "clib": {
    "dir": "go/clib",
    "library": "libtabnasc",
    "abi": "v1",
    "errorCodes": [
      "usage",
      "grammar",
      "handle",
      "internal"
    ]
  },
  "errorCodes": [],
  "docs": "https://tabnas.dev/docs/packages",
  "repository": "https://github.com/tabnas/c",
  "versionSource": "ts/package.json"
}
